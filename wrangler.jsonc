{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker created by the Workers Builds import (it owns the
  // color.apphub.casa custom domain). Never rename.
  "name": "color",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "public"
  },
  "routes": [
    { "pattern": "color.apphub.casa", "custom_domain": true }
  ]
}
